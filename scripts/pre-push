#!/usr/bin/env bash
# inkflow pre-push gate. Hosts:
#   - Linux/Jetson (real deployment host): fmt + clippy + test +
#     build. The build gate is what catches Linux-only link errors
#     (inotify_*, __errno_location, etc.) before they reach main.
#   - macOS dev box: fmt + clippy + test (skip build — Linux-only
#     symbols don't link here, but the Jetson autoloop has already
#     built the same commit so the production binary is fine).
set -euo pipefail
export CARGO_TARGET_DIR=/mnt/ssd/codespace/.cargo-target/inkflow
cargo fmt --check
cargo clippy --release -- -D warnings
cargo test --release
if [ "$(uname)" = "Linux" ]; then
    cargo build --release
fi
